m:uppercase;}.p1-region{text-align:right;font-weight:700;font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--dek);line-height:1.5;margin-top:-30px;}.metarow{display:flex;border-top:2px solid var(--rule);border-bottom:2px solid var(--rule);margin:10px 0 0;}.metarow .cell{padding:9px 14px 9px 0;border-right:1px solid var(--hair);}.metarow .cell:last-child{border-right:none;padding-right:0;padding-left:14px;flex:1;}.metarow .ml{font-weight:600;font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--dek);margin-bottom:5px;}.metarow .mv{font-weight:700;font-size:14px;}.cellw1{width:118px;} .cellw2{width:150px;} .cellw3{width:150px;}.band{background:var(--green);color:#fff;padding:18px 22px 20px;margin:16px 0 16px;}.band .bk{color:#bfe2d7;font-weight:700;font-size:11px;letter-spacing:.18em;text-transform:uppercase;margin-bottom:10px;}.band h1{font-weight:800;font-size:30px;line-height:1.08;letter-spacing:-.02em;}.p1cols{column-count:2;column-gap:0.4in;font-size:13.5px;line-height:1.45;}.p1cols p{margin-bottom:10px;}.p1cols .lead{font-weight:700;}.pull{border-left:3px solid var(--green);padding:2px 0 2px 14px;font-weight:700;font-size:15px;line-height:1.3;break-inside:avoid;margin-bottom:8px;}.pull-attr{color:var(--dek);font-weight:600;font-size:10px;letter-spacing:.12em;text-transform:uppercase;padding-left:14px;}.numbers{border-top:2px solid var(--rule);display:flex;padding-top:12px;margin-top:14px;}.numbers .n{flex:1;padding-right:16px;border-right:1px solid var(--hair);}.numbers .n:last-child{border-right:none;padding-right:0;padding-left:16px;}.numbers .n+.n{padding-left:16px;}.numbers .big{color:var(--green);font-weight:800;font-size:36px;line-height:.95;letter-spacing:-.02em;}.numbers .lab{color:var(--dek);font-size:12.5px;line-height:1.4;margin-top:8px;}.numbers-tag{margin-top:8px;font-weight:600;font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--dek);}.social-top{position:absolute;top:0;right:0;font-weight:700;font-size:11px;letter-spacing:.13em;text-transform:uppercase;white-space:nowrap;}.social-top a{color:var(--green);text-decoration:none;}.blockhead{display:flex;justify-content:space-between;align-items:baseline;border-top:2px solid var(--rule);padding-top:10px;margin:11px 0 10px;}.blockhead .ct{font-weight:800;font-size:15px;letter-spacing:-.01em;}.blockhead .cs{font-weight:600;font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:var(--dek);}.watch-grid{display:grid;grid-template-columns:1fr 1fr 1fr;column-gap:0.36in;row-gap:12px;}.witem{border-top:1px solid var(--hair);padding-top:8px;}.witem .wt{font-weight:700;font-size:12.5px;line-height:1.26;letter-spacing:-.005em;}.witem .read{margin-top:6px;}.inside{border-top:2px solid var(--rule);padding-top:10px;margin-top:14px;}.inside .ih{font-weight:800;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--green);margin-bottom:10px;}.inside .ig{display:grid;grid-template-columns:1fr 1fr 1fr;column-gap:0.36in;}.inside .ii{border-top:1px solid var(--hair);padding-top:8px;}.inside .ii .ik{font-weight:600;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--dek);margin-bottom:5px;}.inside .ii .it{font-weight:700;font-size:13px;line-height:1.25;letter-spacing:-.005em;}@page flow{size:8.5in 11in;margin:0.55in 0.55in 0.6in}.review{page:flow}.rhead{border-bottom:2px solid var(--rule);padding-bottom:7px;margin-bottom:14px;overflow:hidden}.rhead .l{float:left;font-weight:800;font-size:13px;letter-spacing:.13em;text-transform:uppercase}.rhead .r{float:right;font-weight:600;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--dek)}.rgrid{font-size:0}.rsech{display:block;width:100%;margin:4px 0 12px;break-after:avoid;page-break-after:avoid}.rsech~.rsech{break-before:page;page-break-before:always;margin-top:0}.rsech .sect{display:flex;align-items:center;gap:14px;margin:0}.rcard{display:inline-block;width:32%;margin-right:2%;margin-bottom:12px;vertical-align:top;break-inside:avoid;font-size:15px}.rcard.c3{margin-right:0}.rcard .rh{font-weight:800;font-size:18px;letter-spacing:-.012em;line-height:1.12;margin-bottom:8px}.rcard .rh a{color:inherit;text-decoration:none}.rcard .dek{margin-bottom:2px}.radarblock,.aboutblock{clear:both;break-inside:avoid}.radarblock{margin-top:6px}.aboutblock p{font-size:12px;line-height:1.45;color:var(--dek)}.endfoot{clear:both;break-inside:avoid;border-top:2px solid var(--rule);margin-top:16px;padding-top:10px}.endfoot .frow{display:flex;justify-content:space-between}.endfoot .fbrand{font-weight:800;font-size:16px;letter-spacing:-.01em}.endfoot .ftag{font-size:10.5px;color:var(--dek);margin-top:3px}.endfoot .fcol{font-size:10.5px;color:var(--dek);line-height:1.6;text-align:right}.endfoot .fcol a{color:var(--green);text-decoration:none}.endfoot .legal{font-size:9px;color:var(--dek);margin-top:8px;line-height:1.45}</style></head><body><section class='page'><div class='p1-top'><div class='p1-kick'>Pharma &amp; Healthcare Intelligence</div><div class='social-top'><a href='https://www.linkedin.com/company/healthsignalsnews'>LinkedIn</a> · <a href='https://x.com/HealthsignalsX'>X</a></div><div class='wm'>The<br>HealthSignals<br>Brief</div><div class='p1-region'>Latin America<br>&amp; the United States</div></div><div class='metarow'><div class='cell cellw1'><div class='ml'>Issue</div><div class='mv'>{{var.input.issue}}</div></div><div class='cell cellw2'><div class='ml'>Cadence</div><div class='mv'>Bi-weekly</div></div><div class='cell cellw3'><div class='ml'>Dated</div><div class='mv'>{{formatDate(now; \"DD MMM YYYY\")}}</div></div><div class='cell'><div class='ml'>Coverage</div><div class='mv'>{{var.input.article_count}} articles &middot; last 10 days</div></div></div>{{var.input.dyn_p1}}<div class='folio'>01</div></section><section class='review'><div class='rhead'><div class='l'>This Issue in Review</div><div class='r'>Each headline links to the full article on healthsignals.news</div></div><div class='rgrid'>{{var.input.dyn_review}}</div><div class='radarblock'><div class='blockhead' style='margin-top:0'><div class='ct'>Regulatory Radar &mdash; What to watch</div><div class='cs'>from this issue&rsquo;s coverage</div></div><div class='watch-grid'>{{var.input.dyn_radar}}</div></div><div class='aboutblock'><div class='blockhead'><div class='ct'>About this Brief</div><div class='cs'>Method &amp; independence</div></div><p>The HealthSignals Brief compiles the latest coverage published on healthsignals.news. Every story links to the full article, where sources are cited. The Brief is professional information for the health and life-sciences sector; it is not medical advice. Sponsorship, when present, buys placement and co-branding, never editorial conclusions.</p></div><div class='endfoot'><div class='frow'><div><div class='fbrand'>THE HEALTHSIGNALS BRIEF</div><div class='ftag'>Editorial intelligence &middot; Pharma &amp; healthcare &middot; Latin America &amp; the US</div></div><div class='fcol'><a href='https://healthsignals.news/newsletter/'>Subscribe</a> &middot; <a href='https://healthsignals.news/privacy/'>Privacy</a> &middot; <a href='https://healthsignals.news/terms/'>Terms</a><br>brief@healthsignals.news</div></div><div class='legal'>&copy; {{formatDate(now; \"YYYY\")}} HEALTHSIGNALS LLC &middot; 407 Lincoln Rd, Suite 6H, PMB 1683, Miami Beach, FL 33139, USA. To stop receiving the Brief, use the unsubscribe link in the email that delivered it or write to brief@healthsignals.news.</div></div></section></body></html>"
